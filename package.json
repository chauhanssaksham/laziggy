{
    "name": "laziggy",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "postbuild": "[ -n \"$POSTHOG_CLI_API_KEY\" ] && [ -n \"$VERCEL_DEPLOYMENT_ID\" ] && posthog-cli sourcemap inject --directory ./build && posthog-cli sourcemap upload --directory ./build --release-name $VERCEL_DEPLOYMENT_ID || echo 'Skipping PostHog sourcemap upload (env vars missing — expected on local builds)'",
        "dev": "react-router dev",
        "start": "react-router-serve ./build/server/index.js",
        "typecheck": "react-router typegen && tsc",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@posthog/react": "^1.7.0",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slot": "^1.2.3",
        "@react-router/node": "^7.7.1",
        "@supabase/supabase-js": "^2.90.1",
        "@vercel/functions": "^3.4.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "isbot": "^5",
        "lucide-react": "^0.541.0",
        "nanoid": "^5.1.6",
        "pino": "^10.3.1",
        "posthog-js": "^1.333.0",
        "posthog-node": "^5.21.2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router": "^7.7.1",
        "tailwind-merge": "^3.3.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@posthog/cli": "^0.7.9",
        "@react-router/dev": "^7.7.1",
        "@tailwindcss/vite": "^4.1.4",
        "@types/node": "^20",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vercel/react-router": "^1.2.3",
        "@vitest/coverage-v8": "^4.0.6",
        "@vitest/ui": "^4.0.6",
        "eslint": "^9.39.4",
        "happy-dom": "^20.0.10",
        "pino-pretty": "^13.1.3",
        "tailwindcss": "^4.1.4",
        "tsx": "^4.20.6",
        "tw-animate-css": "^1.3.8",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.58.0",
        "vite": "^6.3.3",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.0.6"
    }
}
